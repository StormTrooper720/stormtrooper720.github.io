---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';

const works = (await getCollection('projects'))
  .sort((a, b) => {
    const byDate = b.data.publishDate.getTime() - a.data.publishDate.getTime();
    return byDate || (a.data.order ?? 999) - (b.data.order ?? 999);
  })
  .slice(0, 3);

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
---

<BaseLayout
  title="Home"
  description="A minimal portfolio and writing theme for careful technical work."
>
  <section class="hero section">
    <p class="eyebrow">Projects / Blogs / Hobbies</p>
    <h1>Inspired to Create</h1>
    <p class="lead">
      Here you can find my projects and blog as well my personal hobbies and interests.
      Whether it's my custom quadcopter, a robot that plays Connect Four, posts about what I'm working on, and even photography, it's here.
    </p>
    <div class="action-row" aria-label="Primary links">
      <a class="button" href={withBase('/projects/')}>View Projects</a>
      <a class="text-link" href={withBase('/blog/')}>Read Blog</a>
    </div>
  </section>

  <section class="section split-overview" aria-label="Theme overview">
    <div>
      <p class="eyebrow">A short about me</p>
      <h2>The one behind it all</h2>
      <a class="button" href="/about">More about me</a>
    </div>
    <div class="feature-list">
      <article>
        <h3>What I'm studying</h3>
        <p>I'm an undergraduate student currently studying mechanical engineering. I'm also looking to pursue a minor in robotics engineering as well.</p>
      </article>
      <article>
        <h3>Why I chose M.E.</h3>
        <p>I chose mechanical engineering because I want to go into the field of robotics and mechatronics.
          I want to design and make dynamic systems that utilize mechanical, electrical, and computational components. With my main focus being on mechanics.</p>
      </article>
      <article>
        <h3>What motivates me</h3>
        <p>Ever since I got an LED to blink on its own, I've gotten satisfaction making something, over coming its challenges, and finally experiencing the result in front of me.</p>
      </article>
    </div>
  </section>

  <section class="section index-feed" aria-labelledby="latest-works">
    <div class="section-heading">
      <p class="eyebrow">Latest Projects</p>
      <h2 id="latest-works">Built to Learn</h2>
      <a class="text-link" href={withBase('/projects/')}>All projects</a>
    </div>

    {
      works.length > 0 ? (
        <div class="highlight-grid">
          {works.map((work) => (
            <article class="highlight-card">
              {work.data.thumbnail && (
                <Image
                  src={work.data.thumbnail}
                  alt=""
                  width={720}
                  height={480}
                  loading="lazy"
                />
              )}
              <div>
                <p class="meta">{formatDate(work.data.publishDate)}</p>
                <h3>
                  <a href={withBase(`/projects/${work.id}/`)}>{work.data.title}</a>
                </h3>
                <p>{work.data.description}</p>
                {work.data.tech.length > 0 && (
                  <ul class="tag-list" aria-label={`${work.data.title} technology`}>
                    {work.data.tech.slice(0, 4).map((tech) => (
                      <li>{tech}</li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p>Add projects under <code>src/content/projects</code> to surface the latest projects here.</p>
        </div>
      )
    }
  </section>

  <section class="section index-feed" aria-labelledby="latest-notes">
    <div class="section-heading">
      <p class="eyebrow">Latest blog</p>
      <h2 id="latest-notes">Behind the Scenes</h2>
      <a class="text-link" href={withBase('/blog/')}>All posts</a>
    </div>

    {
      posts.length > 0 ? (
        <div class="note-list">
          {posts.map((post) => (
            <article class="note-row">
              {post.data.heroImage && (
                <Image
                  src={post.data.heroImage}
                  alt=""
                  width={320}
                  height={220}
                  loading="lazy"
                />
              )}
              <div>
                <p class="meta">{formatDate(post.data.publishDate)}</p>
                <h3>
                  <a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p>Add blog entries under <code>src/content/blog</code> to surface the latest notes here.</p>
        </div>
      )
    }
  </section>
</BaseLayout>
